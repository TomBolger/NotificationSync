From d53df3e6ed84840e1d4fe61d508e611bf6e418ac Mon Sep 17 00:00:00 2001
From: TomBolger <49487944+TomBolger@users.noreply.github.com>
Date: Mon, 23 Nov 2026 19:00:31 +0000
Subject: [PATCH 3/5] services/notifications: add a preference to group
 notifications by app

Add notifGroupByApp, off by default, to stack notifications by the app
that posted them in the notifications history, as phones do in their
notification shade.

Assisted-by: LLM
---
 .../notifications/alerts_preferences_private.h   | 16 ++++++++++++++++
 .../services/notifications/alerts_preferences.c  | 14 ++++++++++++++
 tests/stubs/default/alerts_preferences.c         |  4 ++++
 3 files changed, 34 insertions(+)

diff --git a/include/pbl/services/notifications/alerts_preferences_private.h b/include/pbl/services/notifications/alerts_preferences_private.h
index fafd855bf..6ad77c1c1 100644
--- a/include/pbl/services/notifications/alerts_preferences_private.h
+++ b/include/pbl/services/notifications/alerts_preferences_private.h
@@ -149,6 +149,22 @@ bool alerts_preferences_get_notification_dismissal_sync(void);
  */
 void alerts_preferences_set_notification_dismissal_sync(bool enable);
 
+/**
+ * @brief Get whether notifications are stacked by app in history, as the phone does.
+ *
+ * Takes precedence over grouping by sender.
+ *
+ * @return true if enabled, false otherwise (default).
+ */
+bool alerts_preferences_get_notification_group_by_app(void);
+
+/**
+ * @brief Set whether notifications are stacked by app in history.
+ *
+ * @param enable true to enable.
+ */
+void alerts_preferences_set_notification_group_by_app(bool enable);
+
 /** @brief Age range within which notifications from the same sender are grouped. */
 typedef enum {
   /** Grouping disabled (default). */
diff --git a/pebble/services/notifications/alerts_preferences.c b/pebble/services/notifications/alerts_preferences.c
index 39869d0ea..123877d11 100644
--- a/pebble/services/notifications/alerts_preferences.c
+++ b/pebble/services/notifications/alerts_preferences.c
@@ -115,6 +115,9 @@ static bool s_notification_respect_phone_silence = false;
 #define PREF_KEY_NOTIF_DISMISSAL_SYNC "notifDismissalSync"
 static bool s_notification_dismissal_sync = false;
 
+#define PREF_KEY_NOTIF_GROUP_BY_APP "notifGroupByApp"
+static bool s_notification_group_by_app = false;
+
 #define PREF_KEY_NOTIF_GROUPING_RANGE "notifGroupingRange"
 static NotificationGroupingRange s_notification_grouping_range = NotificationGroupingRange_Never;
 
@@ -483,6 +486,7 @@ void alerts_preferences_init(void) {
   RESTORE_PREF(PREF_KEY_NOTIF_BACKLIGHT, s_notification_backlight);
   RESTORE_PREF(PREF_KEY_NOTIF_RESPECT_PHONE_SILENCE, s_notification_respect_phone_silence);
   RESTORE_PREF(PREF_KEY_NOTIF_DISMISSAL_SYNC, s_notification_dismissal_sync);
+  RESTORE_PREF(PREF_KEY_NOTIF_GROUP_BY_APP, s_notification_group_by_app);
   RESTORE_PREF(PREF_KEY_NOTIF_GROUPING_RANGE, s_notification_grouping_range);
   RESTORE_PREF(PREF_KEY_NOTIF_STATUS_BAR_STYLE, s_notification_status_bar_style);
   RESTORE_PREF(PREF_KEY_NOTIF_TEXT_SIZE, s_notification_content_size);
@@ -599,6 +603,15 @@ void alerts_preferences_set_notification_dismissal_sync(bool enable) {
   SET_PREF(PREF_KEY_NOTIF_DISMISSAL_SYNC, s_notification_dismissal_sync);
 }
 
+bool alerts_preferences_get_notification_group_by_app(void) {
+  return s_notification_group_by_app;
+}
+
+void alerts_preferences_set_notification_group_by_app(bool enable) {
+  s_notification_group_by_app = enable;
+  SET_PREF(PREF_KEY_NOTIF_GROUP_BY_APP, s_notification_group_by_app);
+}
+
 NotificationGroupingRange alerts_preferences_get_notification_grouping_range(void) {
   return (s_notification_grouping_range < NotificationGroupingRangeCount)
              ? s_notification_grouping_range
@@ -1002,6 +1015,7 @@ void alerts_preferences_handle_blob_db_event(PebbleBlobDBEvent *event) {
   RELOAD_IF_MATCH(PREF_KEY_NOTIF_BACKLIGHT, s_notification_backlight);
   RELOAD_IF_MATCH(PREF_KEY_NOTIF_RESPECT_PHONE_SILENCE, s_notification_respect_phone_silence);
   RELOAD_IF_MATCH(PREF_KEY_NOTIF_DISMISSAL_SYNC, s_notification_dismissal_sync);
+  RELOAD_IF_MATCH(PREF_KEY_NOTIF_GROUP_BY_APP, s_notification_group_by_app);
   RELOAD_IF_MATCH(PREF_KEY_NOTIF_GROUPING_RANGE, s_notification_grouping_range);
   RELOAD_IF_MATCH(PREF_KEY_NOTIF_STATUS_BAR_STYLE, s_notification_status_bar_style);
   RELOAD_IF_MATCH(PREF_KEY_NOTIF_TEXT_SIZE, s_notification_content_size);
diff --git a/tests/stubs/default/alerts_preferences.c b/tests/stubs/default/alerts_preferences.c
index 50f9e6b21..362cea02d 100644
--- a/tests/stubs/default/alerts_preferences.c
+++ b/tests/stubs/default/alerts_preferences.c
@@ -36,6 +36,10 @@ bool PBL_WEAK alerts_preferences_get_notification_dismissal_sync(void) {
   return false;
 }
 
+bool PBL_WEAK alerts_preferences_get_notification_group_by_app(void) {
+  return false;
+}
+
 NotificationStatusBarStyle PBL_WEAK alerts_preferences_get_notification_status_bar_style(void) {
   return NotificationStatusBarStyle_Default;
 }
-- 
