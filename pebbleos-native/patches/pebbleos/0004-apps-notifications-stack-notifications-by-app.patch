From 3ab7723656b3802e6b6a5ae83721c3619508fcf7 Mon Sep 17 00:00:00 2001
From: TomBolger <49487944+TomBolger@users.noreply.github.com>
Date: Mon, 23 Nov 2026 19:00:31 +0000
Subject: [PATCH 4/5] apps/notifications: stack notifications by app

When grouping by app is enabled, group the notification history by the
app name attribute instead of the sender, for notifications from both iOS
and Android, regardless of their age. Notifications without an app name
stay on their own rows.

Opening an app's stack lists who each notification is from and its text,
since the stack's title is the app.

Assisted-by: LLM
---
 pebble/apps/system/notifications.c            | 27 +++++++
 pebble/apps/system/notifications_history.c    | 21 +++++-
 pebble/apps/system/notifications_history.h    |  3 +
 .../test_notifications_history.c              | 74 +++++++++++++++++++
 4 files changed, 124 insertions(+), 1 deletion(-)

diff --git a/pebble/apps/system/notifications.c b/pebble/apps/system/notifications.c
index c2bea9f85..6f23694e8 100644
--- a/pebble/apps/system/notifications.c
+++ b/pebble/apps/system/notifications.c
@@ -74,6 +74,8 @@ struct NotificationGroupWindow {
   Uuid *notification_ids;
   uint16_t count;
   char *sender;
+  //! The group is an app's notifications: rows tell who each one is from
+  bool by_app;
   char time_buffer[TIME_STRING_REQUIRED_LENGTH];
 };
 
@@ -118,9 +120,11 @@ static void prv_load_notification_storage(NotificationsData *data) {
 
   char sender[ATTRIBUTE_TITLE_MAX_LEN + 1];
   char title[ATTRIBUTE_TITLE_MAX_LEN + 1];
