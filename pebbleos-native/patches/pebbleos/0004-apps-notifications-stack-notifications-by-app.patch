   };
   AttributeList attr_list = {
     .num_attributes = PBL_ARRAY_SIZE(attributes),
@@ -205,6 +209,11 @@ static void prv_loaded_notification_list_deinit(LoadedNotificationNode *loaded_l
 }
 
 static void prv_notifications_history_init(NotificationsData *data) {
+  if (alerts_preferences_get_notification_group_by_app()) {
+    notifications_history_init_by_app(&data->history);
+    return;
+  }
+
   const NotificationGroupingRange range = alerts_preferences_get_notification_grouping_range();
   time_t cutoff = 0;
   time_t window = 0;
@@ -261,6 +270,10 @@ static uint16_t prv_group_window_get_num_rows(MenuLayer *menu_layer, uint16_t se
 
 static int16_t prv_group_window_get_cell_height(MenuLayer *menu_layer, MenuIndex *cell_index,
                                                 void *context) {
+  NotificationGroupWindow *group_window = context;
+  if (group_window->by_app) {
+    return menu_cell_basic_cell_height();
+  }
   const GFont subtitle_font = system_theme_get_font(TextStyleFont_MenuCellSubtitle);
   const GFont caption_font = system_theme_get_font(TextStyleFont_Caption);
   const int16_t saved_height =
@@ -291,6 +304,19 @@ static void prv_group_window_draw_row(GContext *ctx, const Layer *cell_layer, Me
     message = attribute_get_string(&notification->attr_list, AttributeIdTitle, "[Empty]");
   }
 
+  if (group_window->by_app) {
+    const char *from = attribute_get_string(&notification->attr_list, AttributeIdTitle, "");
+    if (PBL_IS_EMPTY_STRING(from) || (from == message)) {
+      from = message;
+      message = nullptr;
+    }
+    menu_cell_basic_draw_custom(ctx, cell_layer, system_theme_get_font(TextStyleFont_MenuCellTitle),
+                                from, nullptr, nullptr,
+                                system_theme_get_font(TextStyleFont_MenuCellSubtitle), message,
+                                nullptr, false, GTextOverflowModeTrailingEllipsis);
+    return;
+  }
+
   clock_get_since_time(group_window->time_buffer, sizeof(group_window->time_buffer),
                        notification->header.timestamp);
   menu_cell_basic_draw_custom(ctx, cell_layer, system_theme_get_font(TextStyleFont_MenuCellTitle),
@@ -351,6 +377,7 @@ static void prv_group_window_unload(Window *window) {
 static void prv_push_group_window(NotificationsData *data, const NotificationHistoryRow *row) {
   NotificationGroupWindow *group_window = app_zalloc_check(sizeof(*group_window));
   group_window->notifications_data = data;
+  group_window->by_app = data->history.group_by_app;
   group_window->count = row->group.count;
   const size_t sender_size = strlen(row->group.sender) + 1;
   group_window->sender = app_malloc_check(sender_size);
diff --git a/pebble/apps/system/notifications_history.c b/pebble/apps/system/notifications_history.c
index 45a39e1e9..2386a9b1a 100644
--- a/pebble/apps/system/notifications_history.c
+++ b/pebble/apps/system/notifications_history.c
@@ -35,6 +35,16 @@ static int prv_member_comparator(void *a, void *b) {
                              &((NotificationHistoryMember *)b)->entry);
 }
 
+static const char *prv_group_app_for_item(const TimelineItem *item, char *buffer,
+                                          size_t buffer_size) {
+  const char *app_name = attribute_get_string(&item->attr_list, AttributeIdAppName, "");
+  strncpy(buffer, app_name, buffer_size - 1);
+  buffer[buffer_size - 1] = '\0';
+  string_strip_trailing_whitespace(buffer, buffer);
+  char *start = (char *)string_strip_leading_whitespace(buffer);
+  return PBL_IS_EMPTY_STRING(start) ? nullptr : start;
+}
+
 static const char *prv_group_sender_for_item(const TimelineItem *item, char *buffer,
                                              size_t buffer_size) {
   static const Uuid s_android_notifications_source = UUID_NOTIFICATIONS_DATA_SOURCE;
@@ -149,6 +159,13 @@ void notifications_history_init(NotificationHistory *history, bool group_by_send
   };
 }
 
+void notifications_history_init_by_app(NotificationHistory *history) {
+  *history = (NotificationHistory){
+    .group_by_sender = true,
+    .group_by_app = true,
+  };
+}
+
 void notifications_history_deinit(NotificationHistory *history) {
   NotificationHistoryRow *row = history->rows;
   while (row) {
@@ -178,7 +195,9 @@ void notifications_history_add_item(NotificationHistory *history, const Timeline
   }
   char buffer[ATTRIBUTE_TITLE_MAX_LEN + 1];
   const char *sender = nullptr;
-  if (history->group_by_sender && (item->header.timestamp >= history->grouping_cutoff)) {
+  if (history->group_by_app) {
+    sender = prv_group_app_for_item(item, buffer, sizeof(buffer));
+  } else if (history->group_by_sender && (item->header.timestamp >= history->grouping_cutoff)) {
     sender = prv_group_sender_for_item(item, buffer, sizeof(buffer));
   }
   if (!sender) {
diff --git a/pebble/apps/system/notifications_history.h b/pebble/apps/system/notifications_history.h
index aae0cad60..f5d3061a2 100644
--- a/pebble/apps/system/notifications_history.h
+++ b/pebble/apps/system/notifications_history.h
@@ -36,6 +36,8 @@ typedef struct NotificationHistoryRow {
 typedef struct NotificationHistory {
   NotificationHistoryRow *rows;
   bool group_by_sender;
+  //! Groups by app instead of sender, for notifications from any phone
+  bool group_by_app;
   time_t grouping_cutoff;
   uint32_t next_sequence;
 } NotificationHistory;
@@ -47,6 +49,7 @@ static inline bool notifications_history_is_hidden(const CommonTimelineItemHeade
 
 void notifications_history_init(NotificationHistory *history, bool group_by_sender,
                                 time_t grouping_cutoff);
+void notifications_history_init_by_app(NotificationHistory *history);
 void notifications_history_deinit(NotificationHistory *history);
 
 void notifications_history_add_header(NotificationHistory *history,
diff --git a/tests/pebble/apps/system_apps/notifications/test_notifications_history.c b/tests/pebble/apps/system_apps/notifications/test_notifications_history.c
index 614e9ca6d..a208e266e 100644
--- a/tests/pebble/apps/system_apps/notifications/test_notifications_history.c
+++ b/tests/pebble/apps/system_apps/notifications/test_notifications_history.c
@@ -366,3 +366,77 @@ void test_notifications_history__actioned_and_dismissed_notifications_are_not_gr
   cl_assert_equal_i(prv_row(0)->group.count, 2);
   prv_assert_id(notifications_history_row_get_latest_id(prv_row(0)), 2);
 }
+
+static void prv_add_app(uint8_t id, time_t timestamp, const char *app_name, bool ios) {
+  static const Uuid s_android_notifications_source = UUID_NOTIFICATIONS_DATA_SOURCE;
+  Attribute attributes[] = {
+    {.id = AttributeIdAppName, .cstring = (char *)app_name},
+    {.id = AttributeIdSender, .cstring = "Anna"},
+  };
+  TimelineItem item = {
+    .header =
+        {
+          .id = prv_id(id),
+          .parent_id = ios ? (Uuid)UUID_INVALID_INIT : s_android_notifications_source,
+          .timestamp = timestamp,
+          .type = TimelineItemTypeNotification,
+          .ancs_notif = ios,
+        },
+    .attr_list = {
+      .num_attributes = app_name ? 2 : 1,
+      .attributes = app_name ? attributes : &attributes[1],
+    },
+  };
+  notifications_history_add_item(&s_history, &item);
+}
+
+void test_notifications_history__by_app_stacks_each_app_from_any_phone(void) {
+  notifications_history_deinit(&s_history);
+  notifications_history_init_by_app(&s_history);
+
+  prv_add_app(1, 100, "Messages", true);
+  prv_add_app(2, 200, "Mail", true);
+  prv_add_app(3, 300, "Messages", true);
+  prv_add_app(4, 400, "Signal", false);
+  prv_add_app(5, 500, "Signal", false);
+
+  cl_assert_equal_i(notifications_history_get_row_count(&s_history), 3);
+  cl_assert_equal_s(prv_row(0)->group.sender, "Signal");
+  cl_assert_equal_i(prv_row(0)->group.count, 2);
+  cl_assert_equal_s(prv_row(1)->group.sender, "Messages");
+  cl_assert_equal_i(prv_row(1)->group.count, 2);
+  prv_assert_id(notifications_history_row_get_latest_id(prv_row(1)), 3);
+  cl_assert_equal_s(prv_row(2)->group.sender, "Mail");
+  cl_assert(!notifications_history_row_is_collapsed_group(prv_row(2)));
+}
+
+// Grouping by app ignores the senders and the age range
+void test_notifications_history__by_app_ignores_sender_and_range(void) {
+  notifications_history_deinit(&s_history);
+  notifications_history_init_by_app(&s_history);
+
+  prv_add(1, 100, "Anna");
+  prv_add(2, 200, "Anna");
+  prv_add_app(3, 0, "Mail", false);
+  prv_add_app(4, 1, "Mail", false);
+
+  cl_assert_equal_i(notifications_history_get_row_count(&s_history), 3);
+  cl_assert(!prv_row(0)->is_group);
+  cl_assert(!prv_row(1)->is_group);
+  cl_assert_equal_s(prv_row(2)->group.sender, "Mail");
+  cl_assert_equal_i(prv_row(2)->group.count, 2);
+}
+
+void test_notifications_history__by_app_without_app_name_remains_individual(void) {
+  notifications_history_deinit(&s_history);
+  notifications_history_init_by_app(&s_history);
+
+  prv_add_app(1, 100, nullptr, false);
+  prv_add_app(2, 200, "  ", false);
+  prv_add_app(3, 300, nullptr, false);
+
+  cl_assert_equal_i(notifications_history_get_row_count(&s_history), 3);
+  for (uint16_t i = 0; i < 3; i++) {
+    cl_assert(!prv_row(i)->is_group);
+  }
+}
